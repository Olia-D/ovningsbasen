rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per family sync code. Knowing the 20-character random code = access.
    // No listing, no deleting, only the two expected fields, size-limited.
    match /progress/{code} {
      allow get: if code.size() == 24;
      allow create, update: if code.size() == 24
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 300000
        && request.resource.data.updated is int;
      allow list, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
